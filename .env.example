# =================================================================
# Smart Household Energy Platform - Production Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# 1. AI & LLM Configuration
# -----------------------------------------------------------------
# Mistral AI API Key (required for natural language anomaly explanations,
# energy trend summaries, maintenance diagnosis, and technician dispatch tickets)
MISTRAL_API_KEY=your_mistral_api_key_here

# Google Gemini API Key (optional fallback assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------
# 2. Database Configuration (MySQL)
# -----------------------------------------------------------------
# Local or remote cloud MySQL database connection parameters
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=smart_energy

# -----------------------------------------------------------------
# 3. Security & Authentication
# -----------------------------------------------------------------
# Secret key used for signing JWT authentication tokens
JWT_SECRET_KEY=generate_a_secure_random_secret_key_here

# -----------------------------------------------------------------
# 4. Networking & CORS
# -----------------------------------------------------------------
# Port for FastAPI backend service (default: 8000)
PORT=8000

# Allowed CORS origins for production (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-production-domain.com

# -----------------------------------------------------------------
# 5. Client Monitoring Agent Configuration
# -----------------------------------------------------------------
# Target REST API endpoint for the live laptop monitoring agent
# (set this to your production backend URL when deploying remotely)
LAPTOP_MONITOR_API_URL=http://localhost:8000/api/telemetry/laptop
